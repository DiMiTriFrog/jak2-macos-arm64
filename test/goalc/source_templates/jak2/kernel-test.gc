
(defun target-function ((a0 uint) (a1 uint) (a2 uint) (a3 uint) (a4 uint) (a5 uint))
  (format #t "TARGET FUNCTION ~D ~D ~D~%" a0 a1 a2)
  (format #t "~D ~D ~D~%" a3 a4 a5)

  (let ((stack-arr (new 'stack-no-clear 'array 'uint8 12)))
    (format #t "Stack Alignemnt ~D/16~%" (logand 15 (the uint stack-arr)))
    )

  (dotimes (i 10)
    (format #t "proc1: ~D~%" i)
    (when (> i 4)
      (format #t "DEACTIVATE PROC 1~%")
      (process-deactivate)
      )
    (suspend)
    )
  )

(define-extern recurse (function int (pointer int32) int))
(defun recurse ((i int) (ptr (pointer int32)))
  (if (> i 0)
      (recurse (- i 1) ptr)
      (suspend)
      )
  (set! (-> ptr) (+ (-> ptr) 1))
  1
  )

(defun target-function-2 ()
  (let ((stack-var (new 'stack-no-clear 'array 'int32 1)))
    (set! (-> stack-var) 0)
    (countdown (i 10)
      (format #t "proc2: ~D~%" (-> stack-var))
      (recurse 5 stack-var)
      )
    )

  )

(defun kernel-test ()
  (define test-process (get-process *nk-dead-pool* process 1024))

  (activate test-process *active-pool* "test-proc" *kernel-dram-stack*)


  (set-to-run (-> test-process main-thread)
              target-function
              1 2 3 4 5 6
              )

  (define test-process-2 (get-process *nk-dead-pool* process 1024))
  ;; test that the kernel fakes having process stacks on the scratchpad.
  (activate test-process-2 *active-pool* "test-2" (the pointer #x70004000))
  (set-to-run (-> test-process-2 main-thread)
              target-function-2
              0 0 0 0 0 0)
  0
  )

(defun init-child-proc (a0 a1 a2 a3 a4 a5)
  (format #t "Args: ~D ~D ~D~%" a0 a1 a2)
  (format #t "~D ~D ~D~%" a3 a4 a5)
  (let ((stack-arr (new 'stack-no-clear 'array 'uint8 12)))
  (format #t "Stack Alignemnt ~D/16~%" (logand 15 (the uint stack-arr)))
  )
  (when (eq? a0 (the int 0))
    (process-deactivate)
  )
  'init-child-proc-result
  )


;; Each kernel process under test gets its own private stack region so that no
;; two processes can alias the same memory.  The stack top is the high end of
;; the region: [top - PROCESS_STACK_SIZE, top).
(defun test-private-stack-top ()
  (let ((stack-block (malloc 'global PROCESS_STACK_SIZE)))
    (&+ (the-as (pointer uint8) stack-block) PROCESS_STACK_SIZE))
  )

(defun test-stack-tops-overlap ((stacks (pointer pointer)) (count int))
  (let ((ok #t))
    (dotimes (i count)
      (let ((top-a (-> stacks i)))
        (when top-a
          (let ((a0 (the int (- (the uint top-a) PROCESS_STACK_SIZE)))
                (a1 (the int (the uint top-a))))
            (dotimes (j count)
              (when (and ok (!= i j) (-> stacks j))
                (let ((b0 (the int (- (the uint (-> stacks j)) PROCESS_STACK_SIZE)))
                      (b1 (the int (the uint (-> stacks j)))))
                  (when (and (< a0 b1) (< b0 a1))
                    (format 0 "TEST-FAIL: stack ~D [~X, ~X) overlaps ~D [~X, ~X)~%"
                            i a0 a1 j b0 b1)
                    (set! ok #f)
                    )
                  )
                )
              )
            )
          )
        )
      )
    ok
    )
  )

(defun initializer-process-function ((a0 int) (child-stack-top (pointer uint8)))
  (let ((child-proc (get-process *nk-dead-pool* process 1024)))
    ;; let's go
    (activate child-proc *active-pool* "child-proc" child-stack-top)
    (let ((result (run-function-in-process child-proc init-child-proc a0 2 3 4 5 6)))
      (format #t "run-function-in-process result: ~A~%" result)
      )
    )

  (process-deactivate)
  )

(defun kernel-test-2 ()
  (let ((stacks (new 'stack-no-clear 'array 'pointer 4)))
    ;; One private stack per process: two initializers and their two children.
    ;; malloc 'global keeps each region alive after this function returns.
    (dotimes (i 4)
      (set! (-> stacks i) (test-private-stack-top))
      )
    (unless (test-stack-tops-overlap stacks 4)
      ;; Reaching this branch means the fixture violated stack ownership.
      ;; Throwing makes the test fail instead of allowing a corrupted process
      ;; setup to continue into the runtime test.
      (throw 'initialize #f))
    (define initalizer-process (get-process *nk-dead-pool* process 1024))
    (activate initalizer-process *active-pool* "initializer-proc" (-> stacks 0))
    (set-to-run (-> initalizer-process main-thread)
                initializer-process-function
                0 (-> stacks 2) 0 0 0 0
                )
    (define initalizer-process-2 (get-process *nk-dead-pool* process 1024))
    (activate initalizer-process-2 *active-pool* "initializer-proc-2" (-> stacks 1))
    (set-to-run (-> initalizer-process-2 main-thread)
                initializer-process-function
                1 (-> stacks 3) 0 0 0 0
                )
    0
    )
  )


(defstate die-state (process)
    :enter (lambda () (format #t "enter die~%") (none))
    :exit (lambda () (format #t "exit die~%") (none))
    :code (lambda ()
            (format #t "time to die!~%")
            (process-deactivate)
            (format #t "don't see me~%")
            )
    )

(defun xmm-check-code (ax ay az aw)
  "This function relies on saved xmm register being backed up on a context switch"
  ;; compiler will put these in xmm8 and xmm9 to keep them from being clobbered
  (let ((x 12.34)
        (y 45.63))
    (dotimes (i 3)
      (format #t "run xmm-check ~f ~f ~D ~D ~D ~D~%" x y ax ay az aw)
      ;; should preserve xmm8 and xmm9
      (suspend)
      )
    ;; get the wreck process and make it go to die state.
    (go-process (process-by-name "wreck-proc" *active-pool*) die-state)
    (go die-state)
    (format #t "unreachable~%")
    )
  )

(defun xmm-wreck-code (ax ay az aw)
  "This function intentionally overwrites xmm8 and xmm9 and suspends"
  (while #t
    (rlet ((x :class fpr :type float :reg xmm8)
           (y :class fpr :type float :reg xmm9))
      (set! x 99.0)
      (set! y 101.0)
      (format #t "wreck: ~D ~D ~D ~D~%" ax ay az aw)
      (suspend)
      (set! x (+ x 1.0))
      (set! y (+ y 1.0))
      )
    )
  )

;; a state.
(defstate xmm-check-state (process)
    :enter (lambda (x y z w) (format #t "enter check: ~D ~D ~D ~D~%" x y z w) (none))
    :exit (lambda () (format #t "exit check~%") (none))
    :code xmm-check-code
    )

(defstate xmm-wreck-state (process)
    :enter (lambda (x y z w) (format #t "enter wreck: ~D ~D ~D ~D~%" x y z w) (none))
    :exit (lambda () (format #t "exit wreck~%") (none))
    :code xmm-wreck-code
    )

(defun state-test ()
  (let ((check-stack-top (test-private-stack-top))
        (wreck-stack-top (test-private-stack-top)))
    (let ((proc (get-process *nk-dead-pool* process 1024)))
      (activate proc *active-pool* "check-proc" check-stack-top)
      (run-now-in-process proc (lambda (x y z w) (go xmm-check-state x y z w))
                          9 8 7 6)
      )

    (let ((proc (get-process *nk-dead-pool* process 1024)))
      (activate proc *active-pool* "wreck-proc" wreck-stack-top)
      (run-next-time-in-process proc (lambda (x y z w) (go xmm-wreck-state x y z w))
                                3 4 5 6)
      )
    )
  0
  )

(defun throw-backup-test ()
  (rlet ((x :reg xmm10 :class fpr :type float))
    (set! x 10.10)
    (let ((proc (get-process *nk-dead-pool* process 1024)))
      (activate proc *active-pool* "asdf" *kernel-dram-stack*)
      (format #t "value now is ~f~%" x)
      (run-now-in-process proc (lambda ()
                                 (rlet ((x2 :reg xmm10 :class fpr :type float))
                                   (set! x2 -1.0)
                                   )
                                 ;; this will throw back.
                                 (process-deactivate)
                                 )
                          )
      (format #t "now its ~f~%" x)

      )
    )
  )

;; Regression for the full ARM64 GOAL saved-GPR context.  The check process
;; keeps seven independent values live across suspend while the second process
;; deliberately overwrites the seven persistent roles before each suspend.
(defun gpr-context-check-code ((a0 uint) (a1 uint) (a2 uint) (a3 uint) (a4 uint) (a5 uint))
  (let ((v0 (+ a0 #x1000))
        (v1 (+ a1 #x2000))
        (v2 (+ a2 #x3000))
        (v3 (+ a3 #x4000))
        (v4 (+ a4 #x5000))
        (v5 (+ a5 #x6000))
        (v6 (+ a0 a5 #x7000)))
    (dotimes (i 32)
      (when (or (!= v0 (+ a0 #x1000))
                (!= v1 (+ a1 #x2000))
                (!= v2 (+ a2 #x3000))
                (!= v3 (+ a3 #x4000))
                (!= v4 (+ a4 #x5000))
                (!= v5 (+ a5 #x6000))
                (!= v6 (+ a0 a5 #x7000)))
        (format #t "GPR-CONTEXT-FAIL cycle ~D~%" i)
        (process-deactivate))
      (suspend))
    (format #t "GPR-CONTEXT-OK~%")
    (process-deactivate))
  )

(defun gpr-context-wreck-code ()
  ;; saved-gpr5/6 are intentionally inside a compile-time ARM64-only branch:
  ;; x86 never parses names which do not exist in its five-register ABI.
  (#when ARM64_TARGET
    (rlet ((s0 :reg saved-gpr0 :type uint)
           (s1 :reg saved-gpr1 :type uint)
           (s2 :reg saved-gpr2 :type uint)
           (s3 :reg saved-gpr3 :type uint)
           (s4 :reg saved-gpr4 :type uint)
           (s5 :reg saved-gpr5 :type uint)
           (s6 :reg saved-gpr6 :type uint))
      (dotimes (i 32)
        (set! s0 (the uint #xA001))
        (set! s1 (the uint #xA002))
        (set! s2 (the uint #xA003))
        (set! s3 (the uint #xA004))
        (set! s4 (the uint #xA005))
        (set! s5 (the uint #xA006))
        (set! s6 (the uint #xA007))
        (suspend))))
  (process-deactivate)
  )

(defun gpr-context-setup ()
  (let ((stacks (new 'stack-no-clear 'array 'pointer 2)))
    (dotimes (i 2)
      (set! (-> stacks i) (test-private-stack-top)))
    (unless (test-stack-tops-overlap stacks 2)
      (throw 'initialize #f))
    (define check-proc (get-process *nk-dead-pool* process 1024))
    (activate check-proc *active-pool* "gpr-context-check" (-> stacks 0))
    (set-to-run (-> check-proc main-thread)
                gpr-context-check-code
                11 22 33 44 55 66)
    (define wreck-proc (get-process *nk-dead-pool* process 1024))
    (activate wreck-proc *active-pool* "gpr-context-wreck" (-> stacks 1))
    (set-to-run (-> wreck-proc main-thread)
                gpr-context-wreck-code
                101 102 103 104 105 106)
    0))

(defun gpr-context-test ()
  (gpr-context-setup)
  0)

;; Negative control: exercise the comparator's failure branch with a known
;; altered sentinel. This guards against a vacuous "process stayed alive" test.
(defun gpr-context-negative-test ()
  (let ((expected #x7000)
        (actual #x7001))
    (if (= expected actual)
        (format #t "GPR-CONTEXT-NEGATIVE-FAIL~%")
        (format #t "GPR-CONTEXT-NEGATIVE-DETECTED slot 6~%")))
  0)
